{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "winner",
    "reasoning",
    "scores"
  ],
  "properties": {
    "winner": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "TIE"
      ]
    },
    "reasoning": {
      "type": "string"
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/outputScore"
        },
        "B": {
          "$ref": "#/$defs/outputScore"
        }
      }
    }
  },
  "$defs": {
    "outputScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness",
        "completeness",
        "evidence_quality",
        "uncertainty_handling",
        "decision_usefulness",
        "overall",
        "strengths",
        "weaknesses"
      ],
      "properties": {
        "correctness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "completeness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "evidence_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "uncertainty_handling": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "decision_usefulness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "overall": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
